# ==============================================================================
# Self-Healing DLQ Auto-Triage Service — Environment Configuration
# Copy this file to .env and fill in your secrets.
# ==============================================================================

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_DLQ_TOPIC=dead_letter_queue
KAFKA_MAIN_TOPIC=orders_main_stream
KAFKA_DEAD_END_TOPIC=dead_end_unrecoverable
KAFKA_CONSUMER_GROUP=dlq-auto-triage-workers

# ── Jev AI Decision API ──────────────────────────────────────────────────────
JEV_API_KEY=your_jev_api_key_here
JEV_BASE_URL=https://api.jev.ai/v1/decide/choice
JEV_TIMEOUT_SECONDS=5

# ── Alerting (PagerDuty / Slack webhook) ─────────────────────────────────────
ALERT_WEBHOOK_URL=https://events.pagerduty.com/v2/enqueue
ALERT_CHANNEL=#dlq-critical-alerts

# ── Triage Worker Pool ───────────────────────────────────────────────────────
WORKER_POOL_SIZE=10
CHANNEL_BUFFER_SIZE=100
MAX_RETRY_COUNT=3
RETRY_COUNT_HEADER=X-Retry-Count

# ── Metrics & Health ─────────────────────────────────────────────────────────
METRICS_PORT=9090
METRICS_PATH=/metrics

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
APP_ENV=production
